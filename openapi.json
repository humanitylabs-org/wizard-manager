{
  "openapi": "3.0.3",
  "info": {
    "title": "Wizard Manager",
    "version": "0.1.0"
  },
  "paths": {
    "/api/state": {
      "get": {
        "summary": "Read persistent conversation, jobs and monitor state",
        "description": "Supports after integer message cursor. messages are ascending and omit unavailable assistant source updates, never user-authored turns. next_after advances over raw retained rows (including suppressed rows); has_more governs paging. Every page includes suppressed_sources, the current canonical source-ID suppression snapshot. Clients must evict matching retained assistant cards and reply metadata even when messages is empty. suppress_source_updates fails closed if the bounded projection is exceeded. When a previously suppressed source becomes available, replay from after=0 with ID deduplication. job_id correlates sends; jobs excludes completed jobs. Polling is read-only and does not perform network visibility checks.",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    },
    "/api/messages": {
      "post": {
        "summary": "Admit an explicit owner message",
        "description": "Body: text, request_id (stable unique string), optional reply_to (Manager message integer). 202 durable queue receipt; replay identical request safely.",
        "responses": {
          "202": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    },
    "/api/settings": {
      "post": {
        "summary": "Pause or resume optional Manager",
        "description": "Body: enabled boolean. Returns fresh state. Worker sessions continue when paused.",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    },
    "/api/retry": {
      "post": {
        "summary": "Retry a failed accepted message",
        "description": "Body: request_id. Only a failed job may retry. Original side-effect idempotency key is retained.",
        "responses": {
          "202": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "App process health",
        "description": "Returns ok, app, version, enabled.",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "Stateless streamable HTTP MCP",
        "description": "initialize, ping, tools/list, tools/call; notifications return 202.",
        "responses": {
          "202": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted host/origin"
          },
          "409": {
            "description": "Disabled state or conflicting request"
          }
        }
      }
    }
  }
}
